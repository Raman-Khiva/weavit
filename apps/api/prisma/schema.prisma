// This is the Prisma schema file for Weavit API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PhaseStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Matches CalendarWeek CalendarTone
enum CalendarTone {
  teal
  violet
  sky
  amber
  rose
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  habits    Habit[]
  todos     Todo[]
  deadlines Deadline[]
  calendars Calendar[]

  calendarEvents CalendarEvent[]
  @@index([clerkId])
}

/// CalendarWeek CalendarSource — named calendars that color/filter events
model Calendar {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  tone      CalendarTone
  visible   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  events CalendarEvent[]

  @@index([userId])
}

/// CalendarWeek CalendarEvent — timed / all-day blocks on the week grid
model CalendarEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title      String
  /// YYYY-MM-DD (UTC calendar day)
  date       String
  /// Minutes from midnight
  start      Int
  /// Minutes from midnight
  end        Int
  allDay     Boolean  @default(false)
  /// Multi-day span for all-day events (UI `days`)
  days       Int?
  location   String?
  video      Boolean  @default(false)
  people     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([calendarId])
  @@index([userId, date])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String        @default("General")
  icon        String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  phases ProjectPhase[]

  @@index([userId])
}

model ProjectPhase {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  status      PhaseStatus @default(PENDING)
  order       Int         @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks ProjectTask[]

  @@index([projectId])
}

model ProjectTask {
  id          String       @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  category    String?
  priority    Priority     @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  notes TaskLogNote[]

  @@index([phaseId])
}

model TaskLogNote {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  author    String?
  createdAt DateTime    @default(now())

  @@index([taskId])
}

/// Habit completion is tracked on `completedDates` (YYYY-MM-DD).
/// `HabitLog` is journal-only and must not be treated as completion.
model Habit {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  frequency      HabitFrequency @default(DAILY)
  category       String         @default("General")
  /// Cached current streak; recomputed from completedDates on write.
  streakCount    Int            @default(0)
  /// Source of truth for which calendar days this habit was completed.
  completedDates String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  logs HabitLog[]

  @@index([userId])
}

/// Journal / notes for a habit. Does not imply completion.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@index([habitId])
  @@index([habitId, createdAt])
}

model Todo {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model Deadline {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  course      String?
  time        String?
  dueDate     DateTime
  priority    Priority @default(MEDIUM)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
