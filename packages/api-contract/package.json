{
  "name": "@weavit/api-contract",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:zod": "orval --config ./orval.config.ts",
    "generate:types": "openapi-typescript ./openapi.json -o ./src/generated/types.ts",
    "generate": "pnpm run generate:zod && pnpm run generate:types"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./zod": {
      "types": "./src/generated/zod.ts",
      "import": "./src/generated/zod.ts",
      "default": "./src/generated/zod.ts"
    },
    "./types": {
      "types": "./src/generated/types.ts",
      "import": "./src/generated/types.ts",
      "default": "./src/generated/types.ts"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "orval": "^8.41.0"
  }
}
